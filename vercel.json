{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/torchviz/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/learning/resources/(.*)", "headers": [{ "key": "Content-Security-Policy", "value": "sandbox allow-scripts allow-downloads" }] }
  ]
}
